# =================================================================
# Google Cloud & Vertex AI Configuration
# =================================================================

# Your Google Cloud Project ID (Required for Vertex AI)
GCP_PROJECT_ID=your-gcp-project-id

# Vertex AI Location / Region (Default: us-central1)
GCP_LOCATION=us-central1

# Path to your GCP Service Account JSON key file
# Either set this, or set standard GOOGLE_APPLICATION_CREDENTIALS,
# or provide GCP_SERVICE_ACCOUNT_INFO as an inline JSON string
GCP_SERVICE_ACCOUNT_FILE=./service-account-key.json
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# GCP_SERVICE_ACCOUNT_INFO={"type": "service_account", ...}

# =================================================================
# API Security & Authentication Settings
# =================================================================

# Enable or disable caller authentication for the API endpoints (default: true)
# Set to false only for local testing / offline development
AUTH_ENABLED=true

# Optional comma-separated list of service account emails permitted to call this API.
# If empty, any valid Google Service Account / Google authenticated caller is permitted.
# Example: my-client-sa@my-project.iam.gserviceaccount.com,another-sa@my-project.iam.gserviceaccount.com
ALLOWED_SERVICE_ACCOUNTS=

# Optional custom API key for direct caller authentication (passed via X-API-Key header)
API_KEY=

# =================================================================
# Default Model Settings
# =================================================================
DEFAULT_IMAGE_MODEL=imagen-3.0-generate-002
DEFAULT_VIDEO_MODEL=veo-2.0-generate-001

# =================================================================
# Server Settings
# =================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
